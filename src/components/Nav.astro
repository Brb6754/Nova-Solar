---
interface Props {
	activa?: string;
}
const { activa = '' } = Astro.props;

const enlaces = [
	{ href: '/', texto: 'Inicio', id: 'inicio' },
	{ href: '/galeria', texto: 'Proyectos', id: 'proyectos' },
	{ href: '/cotizador', texto: 'Cotizador', id: 'cotizador' },
	{ href: '/contacto', texto: 'Contacto', id: 'contacto' },
	{ href: '/citas', texto: 'Citas', id: 'citas' },
];

const wa =
	'https://wa.me/526181699033?text=Hola%20Nova%20Solar%2C%20quiero%20cotizar%20paneles%20solares';
---

<header id="barra" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
	<nav class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-5 py-4 md:px-8">
		<a href="/" class="shrink-0" aria-label="Nova Solar, inicio">
			<img src="/logo.svg" alt="Nova Solar" class="h-9 w-auto md:h-10" width="167" height="100" />
		</a>

		<ul class="hidden list-none items-center gap-1 md:flex">
			{
				enlaces.map((e) => (
					<li>
						<a
							href={e.href}
							aria-current={activa === e.id ? 'page' : undefined}
							class:list={[
								'rounded-full px-3.5 py-2 text-[0.9rem] transition-colors',
								activa === e.id ? 'text-arena' : 'text-ceniza hover:text-arena',
							]}
						>
							{e.texto}
						</a>
					</li>
				))
			}
		</ul>

		<div class="flex items-center gap-3">
			<a href={wa} target="_blank" rel="noopener" class="btn btn-sol !px-5 !py-2.5 !text-[0.9rem]">
				<svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path
						d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"
					></path>
				</svg>
				WhatsApp
			</a>

			<button
				id="btn-menu"
				type="button"
				aria-controls="menu-movil"
				aria-expanded="false"
				aria-label="Abrir menú"
				class="rounded-full border border-white/10 p-2.5 text-arena transition-colors hover:bg-white/5 md:hidden"
			>
				<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
					<path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
			</button>
		</div>
	</nav>

	<div id="menu-movil" hidden class="border-t border-white/10 bg-noche/95 backdrop-blur-xl md:hidden">
		<ul class="mx-auto flex max-w-6xl list-none flex-col px-5 py-3">
			{
				enlaces.map((e) => (
					<li>
						<a
							href={e.href}
							aria-current={activa === e.id ? 'page' : undefined}
							class:list={[
								'block border-b border-white/[0.06] py-3.5 text-[0.95rem] last:border-0',
								activa === e.id ? 'text-brasa' : 'text-ceniza',
							]}
						>
							{e.texto}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</header>

<script>
	const barra = document.getElementById('barra');
	const btn = document.getElementById('btn-menu');
	const menu = document.getElementById('menu-movil');

	// La barra solo se vuelve sólida cuando ya hay contenido detrás de ella.
	const alScroll = () => {
		if (!barra) return;
		barra.classList.toggle('con-fondo', window.scrollY > 24);
	};
	alScroll();
	window.addEventListener('scroll', alScroll, { passive: true });

	btn?.addEventListener('click', () => {
		if (!menu) return;
		const abierto = btn.getAttribute('aria-expanded') === 'true';
		btn.setAttribute('aria-expanded', String(!abierto));
		btn.setAttribute('aria-label', abierto ? 'Abrir menú' : 'Cerrar menú');
		menu.hidden = abierto;
	});
</script>

<style>
	#barra.con-fondo {
		background: rgba(9, 6, 4, 0.72);
		backdrop-filter: blur(16px);
		border-bottom: 1px solid rgba(237, 227, 217, 0.08);
	}
</style>
