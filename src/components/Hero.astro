---
const wa =
	'https://wa.me/526181699033?text=Hola%20Nova%20Solar%2C%20te%20mando%20mi%20recibo%20de%20CFE%20para%20cotizar';

// Caso real de la Familia Reyes (Col. Jardines): seis bimestres antes de
// instalar y los tres primeros ya con paneles. Alturas en % sobre el máximo.
const bimestres = [
	{ alto: 85, solar: false },
	{ alto: 94, solar: false },
	{ alto: 76, solar: false },
	{ alto: 100, solar: false },
	{ alto: 90, solar: false },
	{ alto: 7, solar: true },
	{ alto: 4, solar: true },
	{ alto: 4, solar: true },
];
---

<section class="grano relative isolate overflow-hidden pb-20 pt-28 md:pb-28 md:pt-36">
	<!-- El amanecer. Una sola pieza: arco delgado + bruma. -->
	<div class="horizonte horizonte-hero" aria-hidden="true">
		<div class="bruma anim-sol"></div>
		<div class="arco anim-sol"></div>
	</div>

	<div class="relative z-10 mx-auto max-w-5xl px-5 text-center md:px-8">
		<a href="/galeria" class="pastilla anim-sube d1">
			<span
				class="inline-block h-1.5 w-1.5 rounded-full bg-ambar"
				style="box-shadow: 0 0 8px 1px rgba(251,187,53,.9)"
				aria-hidden="true"></span>
			Así se ven nuestras instalaciones
			<svg class="h-3.5 w-3.5 text-ceniza" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7"></path>
			</svg>
		</a>

		<h1 class="display anim-sube d2 mx-auto mt-8 max-w-4xl" style="font-size: var(--t-display)">
			<span class="titulo-luz block">Tu recibo de luz</span>
			<span class="titulo-fuego block">puede costar $57</span>
		</h1>

		<p
			class="anim-sube d3 mx-auto mt-7 max-w-prosa text-balance text-ceniza"
			style="font-size: var(--t-lead)"
		>
			Instalamos paneles solares en Durango. Mándanos una foto de tu último recibo de CFE y te
			decimos exactamente cuánto vas a dejar de pagar.
		</p>

		<div class="anim-sube d4 mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
			<a href="#como-funciona" class="btn btn-humo w-full sm:w-auto">Cómo funciona</a>
			<a href={wa} target="_blank" rel="noopener" class="btn btn-sol w-full sm:w-auto">
				<svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path
						d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"
					></path>
				</svg>
				Mandar mi recibo
			</a>
		</div>

		<p class="sobre-fuego anim-sube d5 mt-9 text-[0.95rem] font-medium">
			Instalaciones en Durango capital
		</p>
	</div>

	<!-- El objeto del hero: el recibo real, iluminado por el amanecer. -->
	<div class="anim-sube d6 relative z-10 mx-auto mt-14 max-w-xl px-5 md:mt-16 md:px-8">
		<figure
			class="relative overflow-hidden rounded-2xl p-6 md:p-8"
			style="background: linear-gradient(180deg, rgba(52,38,28,.97), rgba(24,17,11,.97));
			       border: 1px solid rgba(255,190,120,.24);
			       backdrop-filter: blur(12px);
			       box-shadow: inset 0 1px 0 rgba(255,225,190,.22), 0 40px 90px -28px rgba(0,0,0,.95)"
		>
			<figcaption class="flex items-baseline justify-between gap-4 text-[0.85rem] text-[#b9aa9d]">
				<span>Recibo CFE · uso doméstico</span>
				<span>Col. Jardines, Durango</span>
			</figcaption>

			<div
				class="relative mt-7 flex h-32 items-end gap-2 md:h-40 md:gap-3"
				role="img"
				aria-label="Gráfica del recibo bimestral: cinco bimestres alrededor de 6,800 pesos y, tras instalar paneles, tres bimestres de 57 pesos."
			>
				{
					bimestres.map((b, i) => (
						<div
							class:list={['anim-barra relative flex-1 rounded-t-[3px]', `d${i + 1}`]}
							style={`height:${b.alto}%; animation-delay:${760 + i * 70}ms; ${
								b.solar
									? 'background:linear-gradient(180deg,var(--ambar),var(--brasa));box-shadow:0 0 16px rgba(255,140,30,.8)'
									: 'background:linear-gradient(180deg,rgba(237,227,217,.42),rgba(237,227,217,.24))'
							}`}
							aria-hidden="true"
						/>
					))
				}

				<!-- Marca del momento exacto en que entró el sistema -->
				<div
					class="pointer-events-none absolute inset-y-0 border-l border-dashed border-white/45"
					style="left: calc(62.5% - 4px)"
					aria-hidden="true"
				>
				</div>
				<span
					class="pointer-events-none absolute -top-1 text-[0.75rem] text-[#c9bbae]"
					style="left: calc(62.5% + 6px)"
					aria-hidden="true">instalación</span
				>
			</div>

			<div class="mt-7 grid grid-cols-2 gap-6 border-t border-white/[0.16] pt-6">
				<div>
					<p class="text-[0.85rem] text-[#b9aa9d]">Antes de instalar</p>
					<p class="cifra mt-1 text-2xl font-semibold text-[#d9ccc1] md:text-[1.75rem]">$6,800</p>
				</div>
				<div>
					<p class="text-[0.85rem] text-arena">Bimestre actual</p>
					<p class="cifra display mt-1 text-[2.5rem] text-ambar md:text-[3rem]">$57</p>
				</div>
			</div>
		</figure>

		<p class="mt-4 text-center text-[0.85rem] text-[#a2958a]">
			Caso de la familia Reyes. Tu ahorro depende de tu consumo y del espacio en tu techo.
		</p>
	</div>
</section>
