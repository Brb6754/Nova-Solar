---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Paneles solares en Durango. Ahorra hasta el 98% en tu recibo de CFE. Cotiza tu proyecto residencial o comercial con Nova Solar." />
		<meta name="viewport" content="width=device-width" />
        
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		
        <meta name="generator" content={Astro.generator} />
        
		<title>{title}</title>
	</head>
	<body class="bg-gray-50 text-gray-950 antialiased min-h-screen flex flex-col">
		<slot />
	</body>
</html>