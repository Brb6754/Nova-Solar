---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const correoDestino = 'contacto@novasolardgo.com';
---

<Layout
	title="Cotizador solar en línea | Nova Solar Durango"
	description="Calcula en un minuto cuántos paneles necesitas y cuánto dejarías de pagarle a CFE."
>
	<Nav activa="cotizador" />

	<main class="grano relative isolate overflow-hidden px-5 pb-24 pt-32 md:px-8 md:pt-40">
		<div class="horizonte" aria-hidden="true">
			<div class="bruma" style="top: 20%"></div>
			<div class="arco" style="top: 28%"></div>
		</div>

		<div class="relative z-10 mx-auto max-w-2xl">
			<header class="text-center">
				<h1 class="display titulo-luz" style="font-size: var(--t-h2)">
					Descubre cuánto vas a ahorrar
				</h1>
				<p class="sobre-fuego mx-auto mt-5 max-w-prosa" style="font-size: var(--t-lead)">
					Con lo que pagas hoy de luz nos basta para darte un primer número. Te lo mandamos por
					WhatsApp el mismo día.
				</p>
			</header>

			<div
				class="panel mt-12 !rounded-2xl p-7 md:p-10"
				style="background: linear-gradient(180deg, rgba(52,38,28,.97), rgba(24,17,11,.97));
			       border: 1px solid rgba(255,190,120,.24);
			       backdrop-filter: blur(12px);
			       box-shadow: inset 0 1px 0 rgba(255,225,190,.22), 0 40px 90px -28px rgba(0,0,0,.95)"
			>
				<form id="cotizador-form" class="space-y-6">
					<input type="hidden" name="_subject" value="NUEVA COTIZACIÓN WEB" />
					<input type="hidden" name="_captcha" value="false" />
					<input type="hidden" name="_template" value="table" />

					<div class="grid gap-6 md:grid-cols-2">
						<div>
							<label class="etiqueta" for="nombre">Nombre o empresa</label>
							<input
								type="text"
								id="nombre"
								name="Nombre"
								required
								class="campo"
								placeholder="Juan Pérez"
							/>
						</div>
						<div>
							<label class="etiqueta" for="telefono">WhatsApp</label>
							<input
								type="tel"
								id="telefono"
								name="Telefono"
								required
								class="campo"
								placeholder="618 123 4567"
							/>
						</div>
					</div>

					<div>
						<label class="etiqueta" for="correo">Correo electrónico</label>
						<input
							type="email"
							id="correo"
							name="Correo"
							required
							class="campo"
							placeholder="juan@correo.com"
						/>
					</div>

					<div>
						<label class="etiqueta" for="pago">¿Cuánto pagas de luz al bimestre?</label>
						<div class="relative">
							<span
								class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-ceniza"
								aria-hidden="true">$</span
							>
							<input
								type="number"
								id="pago"
								name="Pago_Bimestral"
								required
								min="500"
								step="1"
								class="campo cifra !pl-9 text-lg font-semibold"
								placeholder="2500"
							/>
						</div>
						<p class="mt-2 text-[0.85rem] text-ceniza">
							Si pagas menos de $500 al bimestre, un sistema solar todavía no se paga solo.
						</p>
					</div>

					<button type="submit" id="btn-submit" class="btn btn-sol w-full !py-4 !text-lg">
						Calcular mi ahorro
					</button>

					<p id="loading-text" class="hidden text-center text-[0.95rem] text-ambar">
						Calculando y enviando tu reporte…
					</p>
				</form>

				<div id="resultado-container" class="hidden">
					<h2 class="display titulo-luz" style="font-size: var(--t-h3)">Ya tenemos tu número</h2>
					<p class="mt-3 text-[0.98rem] leading-relaxed text-ceniza">
						Le llegó a nuestro equipo. Un ingeniero revisa tu caso y te escribe por WhatsApp para
						confirmar los detalles de tu techo.
					</p>

					<dl class="mt-8 grid gap-6 border-t border-white/10 pt-7 sm:grid-cols-2">
						<div>
							<dt class="text-[0.85rem] text-ceniza">Paneles estimados</dt>
							<dd id="res-paneles" class="cifra mt-1.5 text-2xl font-semibold text-arena">—</dd>
						</div>
						<div>
							<dt class="text-[0.85rem] text-ceniza">Nuevo recibo estimado</dt>
							<dd class="cifra mt-1.5 text-2xl font-semibold text-arena">$57</dd>
						</div>
						<div class="sm:col-span-2">
							<dt class="text-[0.85rem] text-arena">Ahorro al año</dt>
							<dd id="res-ahorro" class="cifra display mt-1.5 text-[2.75rem] text-ambar">—</dd>
						</div>
					</dl>

					<p class="mt-7 text-[0.85rem] leading-relaxed text-ceniza">
						Es un cálculo preliminar sobre promedios. El número final depende de tus hábitos de
						consumo y del espacio en tu techo.
					</p>

					<button type="button" id="btn-otro" class="btn btn-humo mt-7 !py-3 !text-[0.95rem]">
						Hacer otro cálculo
					</button>
				</div>
			</div>
		</div>
	</main>

	<Footer />
</Layout>

<script define:vars={{ correoDestino }}>
	const form = document.getElementById('cotizador-form');
	const resultado = document.getElementById('resultado-container');
	const btnSubmit = document.getElementById('btn-submit');
	const cargando = document.getElementById('loading-text');
	const resPaneles = document.getElementById('res-paneles');
	const resAhorro = document.getElementById('res-ahorro');

	document.getElementById('btn-otro')?.addEventListener('click', () => location.reload());

	form?.addEventListener('submit', (e) => {
		e.preventDefault();

		btnSubmit.classList.add('hidden');
		cargando.classList.remove('hidden');

		const datos = new FormData(form);
		const pagoBimestral = parseFloat(datos.get('Pago_Bimestral'));

		// Estimación: un panel ahorra ~$500 al bimestre. Mínimo dos paneles.
		let paneles = Math.ceil(pagoBimestral / 500);
		if (paneles < 2) paneles = 2;

		const ahorroAnual = pagoBimestral * 6; // seis bimestres al año

		fetch(`https://formsubmit.co/ajax/${correoDestino}`, {
			method: 'POST',
			body: datos,
			headers: { Accept: 'application/json' },
		})
			.then((r) => r.json())
			.then((data) => {
				if (!data.success) throw new Error('formsubmit');
				resPaneles.textContent = `${paneles} a ${paneles + 2} paneles`;
				resAhorro.textContent = `$${ahorroAnual.toLocaleString('es-MX')} MXN`;
				form.classList.add('hidden');
				resultado.classList.remove('hidden');
			})
			.catch(() => {
				alert('No pudimos enviar tus datos. Revisa tu conexión e inténtalo otra vez.');
				btnSubmit.classList.remove('hidden');
				cargando.classList.add('hidden');
			});
	});
</script>
