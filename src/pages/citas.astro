---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// Calendly pintado con la paleta del sitio para que el iframe no salga blanco.
const tema = 'background_color=150f0a&text_color=ede3d9&primary_color=ff6400';
const linkOficina = `https://calendly.com/brunoruedabeta/30min?${tema}`;
const linkOnline = `https://calendly.com/brunoruedabeta/online?${tema}`;
---

<Layout
	title="Agendar cita | Nova Solar Durango"
	description="Aparta 30 minutos con un asesor, en nuestra oficina de Guadalupe o por videollamada."
>
	<Nav activa="citas" />

	<main class="grano relative isolate overflow-hidden px-5 pb-24 pt-32 md:px-8 md:pt-40">
		<div class="horizonte" aria-hidden="true">
			<div class="bruma" style="top: 16%"></div>
			<div class="arco" style="top: 24%"></div>
		</div>

		<div class="relative z-10 mx-auto max-w-6xl">
			<header class="max-w-2xl">
				<h1 class="display titulo-luz" style="font-size: var(--t-h2)">Agenda tu asesoría</h1>
				<p class="sobre-fuego mt-5 max-w-prosa" style="font-size: var(--t-lead)">
					Treinta minutos para revisar tu consumo y darte el número real de tu proyecto.
				</p>

				<div
					class="mt-8 inline-flex rounded-full border border-white/10 p-1"
					role="tablist"
					aria-label="Modalidad de la cita"
				>
					<button
						id="btn-oficina"
						type="button"
						role="tab"
						aria-selected="true"
						class="modo modo-activo"
					>
						En oficina
					</button>
					<button id="btn-online" type="button" role="tab" aria-selected="false" class="modo">
						Por videollamada
					</button>
				</div>
			</header>

			<div class="mt-12 grid gap-6 lg:grid-cols-[22rem_1fr]">
				<aside class="panel h-max p-7 lg:sticky lg:top-28">
					<h2 class="display text-arena" style="font-size: var(--t-h3)">Qué vas a sacar</h2>

					<ul class="mt-6 list-none space-y-6">
						<li>
							<h3 class="font-semibold text-arena">El cálculo exacto</h3>
							<p class="mt-1 text-[0.93rem] leading-relaxed text-ceniza">
								Revisamos tu consumo real y el retorno de la inversión, no un promedio.
							</p>
						</li>
						<li>
							<h3 id="titulo-lugar" class="font-semibold text-arena">Dónde nos vemos</h3>
							<p id="texto-lugar" class="mt-1 text-[0.93rem] leading-relaxed text-ceniza">
								Oficina central: C. México 205, Guadalupe, Durango.
							</p>
						</li>
					</ul>

					<div class="mt-8 rounded-xl p-5" style="background: rgba(255,100,0,.08); border: 1px solid rgba(255,100,0,.18)">
						<p id="alerta-texto" class="text-[0.93rem] leading-relaxed text-arena">
							Trae tu último recibo de luz, impreso o en el celular. Sin él no podemos cotizarte bien.
						</p>
					</div>
				</aside>

				<div class="panel overflow-hidden !rounded-2xl">
					<div id="calendly-container" class="min-h-[700px]">
						<div class="calendly-inline-widget" data-url={linkOficina} style="min-width:320px;height:700px;">
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>

	<Footer />
</Layout>

<style>
	.modo {
		border-radius: 999px;
		padding: 0.6rem 1.25rem;
		font-size: 0.9rem;
		font-weight: 600;
		color: #8c8078;
		transition: color 160ms ease, background-color 160ms ease;
	}
	.modo:hover { color: #ede3d9; }
	.modo-activo {
		background: rgba(255, 245, 235, 0.08);
		color: #ede3d9;
	}
</style>

<script is:inline async src="https://assets.calendly.com/assets/external/widget.js"></script>

<script define:vars={{ linkOficina, linkOnline }}>
	const btnOficina = document.getElementById('btn-oficina');
	const btnOnline = document.getElementById('btn-online');
	const contenedor = document.getElementById('calendly-container');
	const tituloLugar = document.getElementById('titulo-lugar');
	const textoLugar = document.getElementById('texto-lugar');
	const alerta = document.getElementById('alerta-texto');

	function cargarCalendly(url) {
		contenedor.innerHTML = '';
		const widget = document.createElement('div');
		widget.className = 'calendly-inline-widget';
		widget.style.minWidth = '320px';
		widget.style.height = '700px';
		contenedor.appendChild(widget);
		if (window.Calendly) {
			window.Calendly.initInlineWidget({ url, parentElement: widget });
		} else {
			widget.setAttribute('data-url', url);
		}
	}

	function seleccionar(activo, inactivo) {
		activo.classList.add('modo-activo');
		activo.setAttribute('aria-selected', 'true');
		inactivo.classList.remove('modo-activo');
		inactivo.setAttribute('aria-selected', 'false');
	}

	btnOnline?.addEventListener('click', () => {
		seleccionar(btnOnline, btnOficina);
		tituloLugar.textContent = 'Dónde nos vemos';
		textoLugar.textContent = 'Te mandamos el link de la videollamada al confirmar la cita.';
		alerta.textContent =
			'Ten a la mano tu último recibo de luz, en PDF o foto. Sin él no podemos cotizarte bien.';
		cargarCalendly(linkOnline);
	});

	btnOficina?.addEventListener('click', () => {
		seleccionar(btnOficina, btnOnline);
		tituloLugar.textContent = 'Dónde nos vemos';
		textoLugar.textContent = 'Oficina central: C. México 205, Guadalupe, Durango.';
		alerta.textContent =
			'Trae tu último recibo de luz, impreso o en el celular. Sin él no podemos cotizarte bien.';
		cargarCalendly(linkOficina);
	});
</script>
