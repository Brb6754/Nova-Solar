---
// src/pages/citas.astro
import '../styles/global.css';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Agendar Cita | Nova Solar</title>
  </head>
  <body class="bg-gray-50 antialiased flex flex-col min-h-screen">
    
    <nav class="fixed w-full z-50 bg-black/90 backdrop-blur-sm">
      <div class="container mx-auto px-4 py-3 flex justify-between items-center">
        <a href="/" class="flex items-center">
            <img src="/logo.svg" alt="Logo Nova Solar" class="h-12 md:h-16 w-auto object-contain" />
        </a>
        <div class="hidden md:flex gap-6 text-sm font-medium text-gray-400">
            <a href="/" class="hover:text-orange-500 transition">Inicio</a>
            <a href="/galeria" class="hover:text-orange-500 transition">Proyectos</a>
            <a href="/#cotizador" class="hover:text-orange-500 transition">Cotizador</a>
            <a href="/contacto" class="hover:text-orange-500 transition">Contacto</a>
            <a href="/citas" class="text-orange-500 font-bold">Citas</a>
        </div>
        <div class="flex items-center gap-4">
             <button id="menu-btn" class="md:hidden text-gray-300 hover:text-white focus:outline-none">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
            </button>
        </div>
      </div>
      <div id="mobile-menu" class="hidden md:hidden bg-black border-t border-gray-800">
          <div class="px-4 py-3 space-y-2">
              <a href="/" class="block text-gray-300 hover:text-white py-2">Inicio</a>
              <a href="/galeria" class="block text-gray-300 hover:text-white py-2">Proyectos</a>
              <a href="/#cotizador" class="block text-gray-300 hover:text-white py-2">Cotizador</a>
              <a href="/contacto" class="block text-gray-300 hover:text-white py-2">Contacto</a>
              <a href="/citas" class="block text-orange-500 font-bold py-2">Citas</a>
          </div>
      </div>
    </nav>

    <main class="flex-grow pt-32 pb-20"> 
      
      <section class="container mx-auto px-4 mb-10 text-center">
        <span class="text-orange-500 font-bold tracking-widest text-xs uppercase mb-2 block">Visita Técnica</span>
        <h1 class="text-3xl md:text-5xl font-bold text-gray-900 mb-4">Agenda tu Evaluación Gratuita</h1>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Selecciona el día y la hora. Nuestro sistema te mostrará solo los espacios disponibles en tiempo real.
        </p>
      </section>

      <section class="container mx-auto px-4 max-w-7xl">
        <div class="flex flex-col lg:flex-row gap-8 items-start">
            
            <div class="w-full lg:w-1/3 bg-white p-6 rounded-2xl shadow-sm border border-gray-100 lg:sticky lg:top-24 h-fit">
                <div class="mb-6">
                    <h3 class="text-xl font-bold text-gray-900 mb-2">Detalles de la Visita</h3>
                    <div class="h-1 w-12 bg-orange-500 rounded"></div>
                </div>
                
                <ul class="space-y-4 text-sm text-gray-600 mb-8">
                    <li class="flex items-start gap-3">
                        <div class="w-5 h-5 bg-orange-50 rounded-full text-orange-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        </div>
                        <span>Análisis de sombras y orientación del techo.</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <div class="w-5 h-5 bg-orange-50 rounded-full text-orange-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                        </div>
                        <span>Revisión de tu instalación eléctrica actual.</span>
                    </li>
                </ul>
                
                <div class="p-4 bg-blue-50 rounded-xl border border-blue-100">
                    <p class="text-xs text-blue-800 font-bold uppercase mb-2">Importante</p>
                    <p class="text-sm text-blue-700">
                        La visita dura aproximadamente 45 minutos. Por favor ten a la mano tu último recibo de luz.
                    </p>
                </div>
            </div>

            <div class="w-full lg:w-2/3 bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden relative" style="min-height: 700px;">
                
                <div class="absolute inset-0 flex items-center justify-center bg-gray-50 -z-10">
                    <span class="text-gray-400 text-sm">Cargando calendario...</span>
                </div>

                <div 
                    class="calendly-inline-widget" 
                    data-url="https://calendly.com/brunoruedabeta/30min" 
                    style="min-width:320px;height:700px;"
                ></div>

            </div>
        </div>
      </section>
    </main>

    <footer class="bg-black text-white py-8 text-center text-sm border-t border-slate-800">
      <p>© 2026 Nova Solar. Todos los derechos reservados.</p>
    </footer>

    <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>

    <script>
        // Script solo para el menú móvil
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        if (menuBtn && mobileMenu) {
            menuBtn.addEventListener('click', () => mobileMenu.classList.toggle('hidden'));
        }
    </script>
  </body>
</html>