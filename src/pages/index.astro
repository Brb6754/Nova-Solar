---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';

import fotoCasa from '../assets/fotos/imgcasa.jpeg';
import fotoNegocio from '../assets/fotos/imgnegocio.jpeg';
import foto1 from '../assets/fotos/img1.jpeg';
import foto2 from '../assets/fotos/img2.jpeg';
import foto3 from '../assets/fotos/img3.jpg';

const wa = (texto: string) =>
	`https://wa.me/526181699033?text=${encodeURIComponent(texto)}`;

const razones = [
	{
		titulo: 'Somos de aquí',
		texto:
			'Si algo falla, el mismo equipo que instaló tu sistema vuelve a tu techo. Sin call center ni intermediarios.',
		icono: 'M12 21s-7-4.8-7-10a7 7 0 1 1 14 0c0 5.2-7 10-7 10Z M12 11h.01',
	},
	{
		titulo: 'Instalación certificada',
		texto:
			'Estructura, cableado y protecciones según norma. El inversor queda dimensionado a tu consumo real, no al catálogo.',
		icono: 'M13 3 4 14h7v7l9-11h-7V3Z',
	},
	{
		titulo: 'Cuentas claras',
		texto:
			'Te entregamos el número antes de firmar: cuánto cuesta, cuánto vas a ahorrar y en cuántos años se paga solo.',
		icono: 'M4 19V5m0 14h16M8 15V9m4 6V6m4 9v-4',
	},
];

const pasos = [
	{
		dia: 'Día 0',
		titulo: 'Mandas tu recibo',
		texto: 'Una foto del recibo de CFE por WhatsApp basta para el primer cálculo.',
		linea: 'rgba(237,227,217,0.14)',
		punto: 'rgba(237,227,217,0.35)',
	},
	{
		dia: 'Día 3',
		titulo: 'Visitamos tu techo',
		texto: 'Medimos el espacio, revisamos tu tablero y confirmamos el número real.',
		linea: 'rgba(255,100,0,0.30)',
		punto: 'rgba(255,100,0,0.55)',
	},
	{
		dia: 'Día 20',
		titulo: 'Instalamos',
		texto: 'Montamos estructura, paneles e inversor. Tu casa no se queda sin luz.',
		linea: 'rgba(255,100,0,0.55)',
		punto: '#ff6400',
	},
	{
		dia: 'Día 40',
		titulo: 'Llega tu recibo nuevo',
		texto: 'Nosotros metemos el trámite de interconexión con CFE y te avisamos cuando queda.',
		linea: '#fbbb35',
		punto: '#fbbb35',
	},
];

const proyectos = [
	{ foto: foto1, alt: 'Paneles solares instalados en una azotea residencial en Durango' },
	{ foto: foto2, alt: 'Estructura con paneles solares en instalación comercial' },
	{ foto: foto3, alt: 'Arreglo de paneles solares terminado por Nova Solar' },
];
---

<Layout>
	<Nav activa="inicio" />

	<main id="contenido">
		<Hero />

		<!-- Por qué Nova Solar -->
		<section class="mx-auto max-w-6xl px-5 py-24 md:px-8 md:py-32">
			<h2 class="display max-w-3xl titulo-luz" style="font-size: var(--t-h2)">
				Lo hacemos todo, incluido el trámite con CFE
			</h2>
			<p class="mt-5 max-w-prosa text-ceniza" style="font-size: var(--t-lead)">
				Tú mandas una foto. Nosotros nos encargamos del cálculo, la instalación y el papeleo.
			</p>

			<div class="mt-14 grid gap-5 md:grid-cols-3">
				{
					razones.map((r) => (
						<article class="panel filo relative p-7 md:p-8">
							<span
								class="flex h-11 w-11 items-center justify-center rounded-xl text-brasa"
								style="background: rgba(255,100,0,.12); border: 1px solid rgba(255,100,0,.2)"
								aria-hidden="true"
							>
								<svg
									class="h-[22px] w-[22px]"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.7"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path d={r.icono} />
								</svg>
							</span>
							<h3 class="mt-6 text-[1.15rem] font-semibold text-arena">{r.titulo}</h3>
							<p class="mt-2.5 text-[0.95rem] leading-relaxed text-ceniza">{r.texto}</p>
						</article>
					))
				}
			</div>
		</section>

		<!-- Cómo funciona: línea de tiempo en días reales -->
		<section id="como-funciona" class="mx-auto max-w-6xl px-5 py-24 md:px-8 md:py-32">
			<h2 class="display max-w-3xl titulo-luz" style="font-size: var(--t-h2)">
				De tu recibo a tu instalación, en 40 días
			</h2>
			<p class="mt-5 max-w-prosa text-ceniza" style="font-size: var(--t-lead)">
				Cuatro momentos. Te avisamos en cada uno.
			</p>

			<ol class="mt-16 grid list-none gap-10 md:grid-cols-4 md:gap-6">
				{
					pasos.map((p) => (
						<li class="relative pt-7" style={`border-top: 1px solid ${p.linea}`}>
							<span
								class="absolute -top-[5px] left-0 h-2.5 w-2.5 rounded-full"
								style={`background:${p.punto}; box-shadow: 0 0 10px ${p.punto}`}
								aria-hidden="true"
							/>
							<p class="cifra text-[0.85rem] font-semibold text-brasa">{p.dia}</p>
							<h3 class="mt-2 text-[1.15rem] font-semibold text-arena">{p.titulo}</h3>
							<p class="mt-2 text-[0.95rem] leading-relaxed text-ceniza">{p.texto}</p>
						</li>
					))
				}
			</ol>
		</section>

		<!-- Casa y negocio -->
		<section class="mx-auto max-w-6xl px-5 py-24 md:px-8 md:py-32">
			<h2 class="display max-w-3xl titulo-luz" style="font-size: var(--t-h2)">
				Para tu casa y para tu negocio
			</h2>

			<div class="mt-14 space-y-5">
				<article class="panel grid items-center gap-8 overflow-hidden md:grid-cols-2 md:gap-0">
					<div class="order-2 p-7 md:order-1 md:p-12">
						<h3 class="display text-arena" style="font-size: var(--t-h3)">Para tu casa</h3>
						<p class="mt-4 max-w-prosa text-[0.98rem] leading-relaxed text-ceniza">
							En verano, cuando el clima se lleva el recibo, tu sistema produce más. Es justo cuando
							más lo necesitas.
						</p>
						<ul class="mt-6 list-none space-y-3 text-[0.95rem] text-arena">
							<li class="flex gap-3">
								<span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-brasa" aria-hidden="true"
								></span>
								Tu casa sube de valor desde el día que queda instalado.
							</li>
							<li class="flex gap-3">
								<span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-brasa" aria-hidden="true"
								></span>
								Los paneles trabajan 25 años; el ahorro no se acaba cuando terminas de pagarlos.
							</li>
						</ul>
						<a
							href={wa('Hola Nova Solar, quiero cotizar paneles para mi casa')}
							target="_blank"
							rel="noopener"
							class="btn btn-humo mt-8 !py-3 !text-[0.95rem]">Cotizar para mi casa</a
						>
					</div>
					<div class="order-1 h-64 md:order-2 md:h-[26rem]">
						<Image
							src={fotoCasa}
							alt="Paneles solares instalados en una casa de Durango"
							widths={[480, 800, 1200]}
							width={1200}
							sizes="(min-width: 768px) 50vw, 100vw"
							format="webp"
							quality={78}
							class="h-full w-full object-cover"
						/>
					</div>
				</article>

				<article class="panel grid items-center gap-8 overflow-hidden md:grid-cols-2 md:gap-0">
					<div class="order-2 p-7 md:p-12">
						<h3 class="display text-arena" style="font-size: var(--t-h3)">Para tu negocio</h3>
						<p class="mt-4 max-w-prosa text-[0.98rem] leading-relaxed text-ceniza">
							La luz suele ser el segundo gasto fijo más grande de un local. Es el único que puedes
							congelar de golpe.
						</p>
						<ul class="mt-6 list-none space-y-3 text-[0.95rem] text-arena">
							<li class="flex gap-3">
								<span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-brasa" aria-hidden="true"
								></span>
								Puedes deducir el 100% de la inversión en el primer año.
							</li>
							<li class="flex gap-3">
								<span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-brasa" aria-hidden="true"
								></span>
								Dimensionamos el sistema a tu demanda contratada, no a un paquete cerrado.
							</li>
						</ul>
						<a
							href={wa('Hola Nova Solar, quiero cotizar paneles para mi negocio')}
							target="_blank"
							rel="noopener"
							class="btn btn-humo mt-8 !py-3 !text-[0.95rem]">Cotizar para mi negocio</a
						>
					</div>
					<div class="order-1 h-64 md:h-[26rem]">
						<Image
							src={fotoNegocio}
							alt="Instalación de paneles solares en un negocio de Durango"
							widths={[480, 800, 1200]}
							width={1200}
							sizes="(min-width: 768px) 50vw, 100vw"
							format="webp"
							quality={78}
							class="h-full w-full object-cover"
						/>
					</div>
				</article>
			</div>
		</section>

		<!-- Proyectos -->
		<section class="mx-auto max-w-6xl px-5 py-24 md:px-8 md:py-32">
			<div class="flex flex-wrap items-end justify-between gap-6">
				<h2 class="display titulo-luz" style="font-size: var(--t-h2)">Instalaciones recientes</h2>
				<a
					href="/galeria"
					class="group inline-flex items-center gap-2 text-[0.95rem] text-arena transition-colors hover:text-brasa"
				>
					Ver el portafolio
					<svg
						class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						aria-hidden="true"
					>
						<path stroke-linecap="round" stroke-linejoin="round" d="M4 12h15m0 0-6-6m6 6-6 6"></path>
					</svg>
				</a>
			</div>

			<div class="mt-12 grid gap-4 sm:grid-cols-3">
				{
					proyectos.map((p) => (
						<Image
							src={p.foto}
							alt={p.alt}
							widths={[400, 700]}
							width={700}
							sizes="(min-width: 640px) 33vw, 100vw"
							format="webp"
							quality={76}
							loading="lazy"
							class="h-60 w-full rounded-xl border border-white/10 object-cover"
						/>
					))
				}
			</div>
		</section>

		<!-- Cierre -->
		<section class="grano relative isolate overflow-hidden px-5 pb-32 pt-24 md:px-8 md:pt-32">
			<div class="horizonte" aria-hidden="true">
				<div class="bruma" style="top: 58%"></div>
				<div class="arco" style="top: 66%"></div>
			</div>

			<div class="relative z-10 mx-auto max-w-3xl text-center">
				<h2 class="display titulo-luz mx-auto max-w-2xl text-balance" style="font-size: var(--t-h2)">
					Manda una foto de tu recibo. Nosotros hacemos el resto.
				</h2>
				<p class="mx-auto mt-6 max-w-prosa text-ceniza" style="font-size: var(--t-lead)">
					Te contestamos con el cálculo de tu ahorro y lo que cuesta el sistema. Sin compromiso.
				</p>
				<div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
					<a href="/cotizador" class="btn btn-humo w-full sm:w-auto">Usar el cotizador</a>
					<a
						href={wa('Hola Nova Solar, te mando mi recibo de CFE para cotizar')}
						target="_blank"
						rel="noopener"
						class="btn btn-sol w-full sm:w-auto"
					>
						<svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path
								d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"
							></path>
						</svg>
						Mandar mi recibo
					</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
