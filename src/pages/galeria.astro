---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

import g1 from '../assets/fotos/IMG_2322.JPG';
import g2 from '../assets/fotos/IMG_3207.jpeg';
import g3 from '../assets/fotos/IMG_4750.jpeg';
import g4 from '../assets/fotos/IMG_4758.jpeg';
import g5 from '../assets/fotos/IMG_5304.jpeg';
import g6 from '../assets/fotos/img1.jpeg';
import g7 from '../assets/fotos/img2.jpeg';
import g8 from '../assets/fotos/img3.jpg';
import g9 from '../assets/fotos/imgcasa.jpeg';
import g10 from '../assets/fotos/imgnegocio.jpeg';

const galeria = [g1, g2, g3, g4, g5, g6, g7, g8, g9, g10];

const wa =
	'https://wa.me/526181699033?text=Hola%20Nova%20Solar%2C%20vi%20su%20galer%C3%ADa%20y%20quiero%20cotizar';
---

<Layout
	title="Proyectos | Nova Solar Durango"
	description="Instalaciones residenciales y comerciales que hemos entregado en Durango."
>
	<Nav activa="proyectos" />

	<main class="grano relative isolate overflow-hidden pb-24 pt-32 md:pt-40">
		<div class="horizonte" aria-hidden="true">
			<div class="bruma" style="top: 14%"></div>
			<div class="arco" style="top: 22%"></div>
		</div>

		<div class="relative z-10">
			<header class="mx-auto max-w-6xl px-5 md:px-8">
				<h1 class="display max-w-3xl titulo-luz" style="font-size: var(--t-h2)">
					Techos que ya trabajan solos
				</h1>
				<p class="sobre-fuego mt-5 max-w-prosa" style="font-size: var(--t-lead)">
					Instalaciones residenciales y comerciales entregadas en Durango. Arrastra para ver más.
				</p>
			</header>

			<!-- Carrusel con scroll-snap nativo: se arrastra con el dedo, con
			     rueda, con teclado, y los botones solo lo empujan. -->
			<section class="relative mt-12" aria-label="Fotos de instalaciones">
				<div
					id="pista"
					tabindex="0"
					class="flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-5 pb-4 md:px-8"
					style="scrollbar-width: none"
				>
					{
						galeria.map((foto, i) => (
							<figure class="m-0 w-[85vw] shrink-0 snap-center sm:w-[60vw] lg:w-[42vw]">
								<Image
									src={foto}
									alt={`Instalación de paneles solares de Nova Solar, proyecto ${i + 1}`}
									widths={[500, 900]}
									width={900}
									sizes="(min-width: 1024px) 42vw, (min-width: 640px) 60vw, 85vw"
									format="webp"
									quality={76}
									loading={i < 2 ? 'eager' : 'lazy'}
									class="h-[58vw] max-h-[480px] w-full rounded-2xl border border-white/10 object-cover"
								/>
							</figure>
						))
					}
				</div>

				<div class="mt-6 flex justify-center gap-3">
					<button id="btn-prev" type="button" class="flecha" aria-label="Fotos anteriores">
						<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M20 12H5m0 0 6-6m-6 6 6 6"></path>
						</svg>
					</button>
					<button id="btn-next" type="button" class="flecha" aria-label="Fotos siguientes">
						<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M4 12h15m0 0-6-6m6 6-6 6"></path>
						</svg>
					</button>
				</div>
			</section>

			<section class="mx-auto mt-24 max-w-6xl px-5 md:px-8">
				<div class="panel !rounded-2xl p-10 text-center md:p-16">
					<h2 class="display titulo-luz mx-auto max-w-xl text-balance" style="font-size: var(--t-h2)">
						¿Listo para ver los tuyos ahí arriba?
					</h2>
					<p class="mx-auto mt-5 max-w-prosa text-ceniza" style="font-size: var(--t-lead)">
						Mándanos tu recibo y te decimos cuántos paneles necesita tu techo.
					</p>
					<a href={wa} target="_blank" rel="noopener" class="btn btn-sol mt-8">Cotizar mi proyecto</a>
				</div>
			</section>
		</div>
	</main>

	<Footer />
</Layout>

<style>
	#pista::-webkit-scrollbar { display: none; }

	.flecha {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 2.75rem;
		width: 2.75rem;
		border-radius: 999px;
		border: 1px solid rgba(237, 227, 217, 0.12);
		color: #ede3d9;
		transition: background-color 160ms ease, border-color 160ms ease;
	}
	.flecha:hover {
		background: rgba(255, 100, 0, 0.12);
		border-color: rgba(255, 100, 0, 0.35);
	}
</style>

<script>
	const pista = document.getElementById('pista');
	const paso = () => (pista ? pista.clientWidth * 0.75 : 0);

	document
		.getElementById('btn-prev')
		?.addEventListener('click', () => pista?.scrollBy({ left: -paso(), behavior: 'smooth' }));
	document
		.getElementById('btn-next')
		?.addEventListener('click', () => pista?.scrollBy({ left: paso(), behavior: 'smooth' }));
</script>
