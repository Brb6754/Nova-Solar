---
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";

const telefonoEmpresa = "526181699033";
const ctaBase = `https://wa.me/${telefonoEmpresa}?text=Hola%20Nova%20Solar,%20quiero%20cotizar%20paneles%20para%20mi%20casa/negocio`;

// Las 5 fotos originales para el carrusel infinito
const imagenesGaleria = [
    "/IMG_2322.JPG",
    "/IMG_3207.jpeg",
    "/IMG_4750.jpeg",
    "/IMG_4758.jpeg",
    "/IMG_5304.jpeg",
    "/img1.jpeg",
    "/img2.jpeg",
    "/img3.jpg",
    "/imgcasa.jpeg",
    "/imgnegocio.jpeg"
];

const logoImg = "/logo.svg";
---

<Layout title="Proyectos Instalados | Nova Solar Durango">
    
    <nav class="fixed w-full z-50 bg-black backdrop-blur-sm border-b border-gray-900">
        <div class="container mx-auto px-6 py-4 flex justify-between items-center">
            <a href="/" class="flex items-center">
                <img src={logoImg} alt="Logo Nova Solar Durango" class="h-10 md:h-12 w-auto object-contain" />
            </a>

            <div class="hidden md:flex gap-8 text-xs font-semibold uppercase tracking-widest text-gray-400">
                <a href="/" class="hover:text-orange-500 transition">Inicio</a>
                <a href="/galeria" class="text-orange-500 transition">Proyectos</a>
                <a href="/cotizador" class="hover:text-orange-500 transition">Cotizador</a>
                <a href="/contacto" class="hover:text-orange-500 transition">Contacto</a>
                <a href="/citas" class="hover:text-orange-500 transition">Citas</a>
            </div>

            <div class="flex items-center gap-4">
                <a
                    href={ctaBase}
                    target="_blank"
                    class="bg-green-500 text-black px-6 py-2.5 rounded-full text-xs font-black uppercase tracking-widest hover:bg-green-600 transition shadow-lg flex items-center gap-2"
                >
                    WhatsApp
                </a>
                
                <button id="menu-btn" class="md:hidden text-gray-300 hover:text-white focus:outline-none">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
            </div>
        </div>
        
        <div id="mobile-menu" class="hidden md:hidden bg-black border-t border-gray-900">
            <div class="px-6 py-4 space-y-2 text-center">
                <a href="/" class="block text-orange-500 py-3 border-b border-gray-900 text-sm font-bold tracking-widest uppercase">Inicio</a>
                <a href="/galeria" class="block text-gray-400 hover:text-white py-3 border-b border-gray-900 text-sm font-bold tracking-widest uppercase">Proyectos</a>
                <a href="/cotizador" class="block text-gray-400 hover:text-white py-3 border-b border-gray-900 text-sm font-bold tracking-widest uppercase">Cotizador</a>
                <a href="/contacto" class="block text-gray-400 hover:text-white py-3 border-b border-gray-900 text-sm font-bold tracking-widest uppercase">Contacto</a>
                <a href="/citas" class="block text-gray-400 hover:text-white py-3 text-sm font-bold tracking-widest uppercase">Citas</a>
            </div>
        </div>
    </nav>

    <main class="pt-36 pb-20 overflow-hidden">
        
        <section class="container mx-auto px-6 mb-12 text-center">
            <span class="text-orange-600 font-bold tracking-widest text-xs uppercase mb-4 block">Portafolio</span>
            <h1 class="text-5xl md:text-6xl font-black text-gray-950 tracking-tighter mb-4">
                Nuestras Instalaciones
            </h1>
            <p class="text-xl text-gray-600 font-light max-w-2xl mx-auto">
                Calidad y excelencia en cada panel. Proyectos residenciales y comerciales en Durango.
            </p>
        </section>

        <section class="w-full mb-20 relative group">
            
            <button id="btn-prev" class="absolute left-2 md:left-8 top-1/2 -translate-y-1/2 z-20 bg-white/90 backdrop-blur-sm text-gray-950 p-4 md:p-5 rounded-full shadow-2xl border border-gray-100 hover:bg-orange-600 hover:text-white transition-all transform hover:scale-110 focus:outline-none hidden md:flex">
                <svg class="w-6 h-6 -translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M15 19l-7-7 7-7"></path></svg>
            </button>

            <div class="w-full overflow-hidden px-6 md:px-24 py-10">
                <div id="carrusel-track" class="flex gap-6 will-change-transform">
                    {
                        imagenesGaleria.map((img) => (
                            <div class="flex-none w-[85vw] md:w-[60vw] lg:w-[45vw] h-[400px] md:h-[500px] rounded-[30px] overflow-hidden shadow-xl border border-gray-200 bg-white select-none">
                                <img
                                    src={img}
                                    alt="Instalación de paneles solares Nova Solar"
                                    class="w-full h-full object-cover hover:scale-105 transition duration-700 pointer-events-none"
                                    loading="lazy"
                                />
                            </div>
                        ))
                    }
                </div>
            </div>

            <button id="btn-next" class="absolute right-2 md:right-8 top-1/2 -translate-y-1/2 z-20 bg-white/90 backdrop-blur-sm text-gray-950 p-4 md:p-5 rounded-full shadow-2xl border border-gray-100 hover:bg-orange-600 hover:text-white transition-all transform hover:scale-110 focus:outline-none hidden md:flex">
                <svg class="w-6 h-6 translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"></path></svg>
            </button>
        </section>

        <section class="container mx-auto px-6">
            <div class="bg-black rounded-[40px] p-12 md:p-16 text-center text-white relative overflow-hidden shadow-2xl">
                <div class="relative z-10 max-w-2xl mx-auto space-y-8">
                    <h2 class="text-4xl md:text-5xl font-black tracking-tighter">
                        ¿Listo para ver tus propios paneles?
                    </h2>
                    <p class="text-gray-400 text-lg font-light">
                        Cotiza hoy mismo y te decimos exactamente cuánto vas a ahorrar.
                    </p>
                    <a
                        href="https://wa.me/526181699033?text=Hola%20Nova%20Solar,%20vi%20su%20galer%C3%ADa%20y%20quiero%20cotizar"
                        target="_blank"
                        class="inline-flex items-center justify-center gap-3 bg-green-500 hover:bg-green-600 text-black font-extrabold text-xl px-10 py-4 rounded-full transition duration-300 shadow-xl"
                    >
                        Cotizar mi Proyecto
                    </a>
                </div>
                
                <div class="absolute top-0 right-0 w-96 h-96 bg-orange-600 rounded-full blur-[120px] opacity-20 translate-x-1/3 -translate-y-1/3 pointer-events-none"></div>
            </div>
        </section>

    </main>

    <footer class="bg-black text-white py-12 text-center text-sm border-t border-gray-900 mt-10">
        <div class="container mx-auto px-6 max-w-5xl">
            <img src={logoImg} alt="Logo Nova Solar" class="h-8 mx-auto mb-6 object-contain opacity-80" />
            <p class="text-gray-500">© 2026 Nova Solar Durango. Todos los derechos reservados.</p>
        </div>
    </footer>

    <script>
        // Lógica del menú móvil
        const btn = document.getElementById("menu-btn");
        const menu = document.getElementById("mobile-menu");
        if (btn && menu) {
            btn.addEventListener("click", () => menu.classList.toggle("hidden"));
        }

        // Lógica del carrusel infinito
        const track = document.getElementById('carrusel-track');
        const btnPrev = document.getElementById('btn-prev');
        const btnNext = document.getElementById('btn-next');
        let autoplayInterval;
        let isTransitioning = false;

        if (track && btnPrev && btnNext) {
            
            const getMoveDistance = () => {
                const firstItem = track.children[0];
                return firstItem.offsetWidth + 24; 
            };

            const moveNext = () => {
                if (isTransitioning) return;
                isTransitioning = true;
                
                const distance = getMoveDistance();
                
                track.style.transition = 'transform 0.5s ease-in-out';
                track.style.transform = `translateX(-${distance}px)`;
                
                track.addEventListener('transitionend', function handler() {
                    track.style.transition = 'none';
                    track.style.transform = 'translateX(0)';
                    track.appendChild(track.firstElementChild);
                    
                    track.removeEventListener('transitionend', handler);
                    isTransitioning = false;
                });
            };

            const movePrev = () => {
                if (isTransitioning) return;
                isTransitioning = true;
                
                const distance = getMoveDistance();
                
                track.insertBefore(track.lastElementChild, track.firstElementChild);
                track.style.transition = 'none';
                track.style.transform = `translateX(-${distance}px)`;
                
                track.offsetHeight; 
                
                track.style.transition = 'transform 0.5s ease-in-out';
                track.style.transform = 'translateX(0)';
                
                track.addEventListener('transitionend', function handler() {
                    track.removeEventListener('transitionend', handler);
                    isTransitioning = false;
                });
            };

            btnNext.addEventListener('click', () => {
                moveNext();
                resetAutoplay();
            });

            btnPrev.addEventListener('click', () => {
                movePrev();
                resetAutoplay();
            });

            const startAutoplay = () => {
                autoplayInterval = setInterval(moveNext, 3000);
            };

            const resetAutoplay = () => {
                clearInterval(autoplayInterval);
                startAutoplay();
            };

            startAutoplay();

            track.parentElement.addEventListener('mouseenter', () => clearInterval(autoplayInterval));
            track.parentElement.addEventListener('mouseleave', startAutoplay);
        }
    </script>
</Layout>