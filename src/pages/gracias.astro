---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout
	title="Mensaje enviado | Nova Solar Durango"
	description="Recibimos tu mensaje. Te contactamos en breve."
>
	<Nav />

	<main class="grano relative isolate flex min-h-screen items-center justify-center overflow-hidden px-5 py-32">
		<div class="horizonte" aria-hidden="true">
			<div class="bruma" style="top: 62%"></div>
			<div class="arco" style="top: 70%"></div>
		</div>

		<div class="relative z-10 max-w-lg text-center">
			<span
				class="mx-auto flex h-14 w-14 items-center justify-center rounded-full text-ambar"
				style="background: rgba(255,100,0,.12); border: 1px solid rgba(255,100,0,.25)"
				aria-hidden="true"
			>
				<svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"></path>
				</svg>
			</span>

			<h1 class="display titulo-luz mt-7" style="font-size: var(--t-h2)">Recibido</h1>
			<p class="sobre-fuego mx-auto mt-5 max-w-prosa" style="font-size: var(--t-lead)">
				Ya nos llegó tu mensaje. Revisamos tu consumo y te escribimos el mismo día hábil.
			</p>

			<div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
				<a href="/" class="btn btn-humo w-full sm:w-auto">Volver al inicio</a>
				<a href="/galeria" class="btn btn-sol w-full sm:w-auto">Ver proyectos</a>
			</div>
		</div>
	</main>
</Layout>
