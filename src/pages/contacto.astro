---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const datos = [
	{
		titulo: 'Oficina',
		valor: 'C. México 205, Guadalupe<br />34220 Durango, Dgo.',
		href: null,
		icono: 'M12 21s-7-4.8-7-10a7 7 0 1 1 14 0c0 5.2-7 10-7 10Z M12 11h.01',
	},
	{
		titulo: 'Teléfono',
		valor: '(618) 169-9033',
		href: 'tel:+526181699033',
		icono: 'M3 5a2 2 0 0 1 2-2h2.6a1 1 0 0 1 .95.68l1.2 3.6a1 1 0 0 1-.5 1.2l-1.6.8a11 11 0 0 0 5.5 5.5l.8-1.6a1 1 0 0 1 1.2-.5l3.6 1.2a1 1 0 0 1 .68.95V19a2 2 0 0 1-2 2h-1C9.7 21 3 14.3 3 6V5Z',
	},
	{
		titulo: 'Correo',
		valor: 'nsolardgo@gmail.com',
		href: 'mailto:nsolardgo@gmail.com',
		icono: 'M3 7.5 10.9 12.8a2 2 0 0 0 2.2 0L21 7.5 M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2Z',
	},
];
---

<Layout
	title="Contacto | Nova Solar Durango"
	description="Escríbenos o llámanos. Oficina en Guadalupe, Durango."
>
	<Nav activa="contacto" />

	<main class="grano relative isolate overflow-hidden px-5 pb-24 pt-32 md:px-8 md:pt-40">
		<div class="horizonte" aria-hidden="true">
			<div class="bruma" style="top: 18%"></div>
			<div class="arco" style="top: 26%"></div>
		</div>

		<div class="relative z-10 mx-auto max-w-5xl">
			<header class="max-w-2xl">
				<h1 class="display titulo-luz" style="font-size: var(--t-h2)">Hablemos</h1>
				<p class="sobre-fuego mt-5 max-w-prosa" style="font-size: var(--t-lead)">
					Déjanos tus datos y te buscamos, o márcanos directo. Contestamos el mismo día hábil.
				</p>
			</header>

			<div class="mt-14 grid gap-12 lg:grid-cols-[1fr_1.15fr] lg:gap-16">
				<div>
					<ul class="list-none space-y-8">
						{
							datos.map((d) => (
								<li class="flex gap-4">
									<span
										class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-brasa"
										style="background: rgba(255,100,0,.12); border: 1px solid rgba(255,100,0,.2)"
										aria-hidden="true"
									>
										<svg
											class="h-[22px] w-[22px]"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.7"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<path d={d.icono} />
										</svg>
									</span>
									<div class="pt-1">
										<h2 class="font-semibold text-arena">{d.titulo}</h2>
										{d.href ? (
											<a
												href={d.href}
												class="mt-1 block text-[0.98rem] text-ceniza transition-colors hover:text-arena"
											>
												{d.valor}
											</a>
										) : (
											<p class="mt-1 text-[0.98rem] leading-relaxed text-ceniza" set:html={d.valor} />
										)}
									</div>
								</li>
							))
						}
					</ul>

					<div class="panel mt-10 p-6">
						<p class="text-[0.95rem] leading-relaxed text-ceniza">
							Si ya tienes tu recibo de CFE a la mano, mandarlo por WhatsApp es lo más rápido: con esa
							foto te damos el cálculo.
						</p>
						<a
							href="https://wa.me/526181699033?text=Hola%20Nova%20Solar%2C%20te%20mando%20mi%20recibo%20de%20CFE"
							target="_blank"
							rel="noopener"
							class="btn btn-sol mt-5 !py-3 !text-[0.95rem]">Mandar mi recibo</a
						>
					</div>
				</div>

				<div
					class="panel !rounded-2xl p-7 md:p-10"
					style="background: linear-gradient(180deg, rgba(52,38,28,.97), rgba(24,17,11,.97));
			       border: 1px solid rgba(255,190,120,.24);
			       backdrop-filter: blur(12px);
			       box-shadow: inset 0 1px 0 rgba(255,225,190,.22), 0 40px 90px -28px rgba(0,0,0,.95)"
				>
					<h2 class="display text-arena" style="font-size: var(--t-h3)">Escríbenos</h2>

					<form action="https://formspree.io/f/xkoowrjo" method="POST" class="mt-7 space-y-5">
						<input type="hidden" name="_next" value="/gracias" />
						<input type="hidden" name="_subject" value="Nuevo contacto desde la web de Nova Solar" />

						<div>
							<label class="etiqueta" for="c-nombre">Nombre</label>
							<input
								type="text"
								id="c-nombre"
								name="nombre"
								required
								class="campo"
								placeholder="Tu nombre"
							/>
						</div>

						<div class="grid gap-5 md:grid-cols-2">
							<div>
								<label class="etiqueta" for="c-email">Correo</label>
								<input
									type="email"
									id="c-email"
									name="email"
									required
									class="campo"
									placeholder="correo@ejemplo.com"
								/>
							</div>
							<div>
								<label class="etiqueta" for="c-tel">Teléfono</label>
								<input
									type="tel"
									id="c-tel"
									name="telefono"
									class="campo"
									placeholder="618 000 0000"
								/>
							</div>
						</div>

						<div>
							<label class="etiqueta" for="c-msg">Mensaje</label>
							<textarea
								id="c-msg"
								name="mensaje"
								rows="4"
								class="campo resize-y"
								placeholder="Cuéntanos qué necesitas"></textarea>
						</div>

						<button type="submit" class="btn btn-sol w-full !py-4">Enviar mensaje</button>
					</form>
				</div>
			</div>
		</div>
	</main>

	<Footer />
</Layout>
