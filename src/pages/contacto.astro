---
import "../styles/global.css";
const telefonoEmpresa = "526181699033";
const ctaBase = `https://wa.me/${telefonoEmpresa}?text=Hola%20Nova%20Solar,%20quiero%20cotizar%20paneles%20para%20mi%20casa/negocio`;
const logoImg = "/logo.svg";

// AQUÍ PONES EL CORREO A DONDE QUIERES QUE LLEGUEN LOS MENSAJES
const correoDestino = "contacto@novasolardgo.com";
---
<Layout title="Contacto | Nova Solar Durango">
    <body class="bg-gray-50 antialiased flex flex-col min-h-screen text-gray-950">
        
        <nav class="fixed w-full z-50 bg-black backdrop-blur-sm border-b border-gray-900">
            <div class="container mx-auto px-6 py-4 flex justify-between items-center">
                <a href="/" class="flex items-center">
                    <img src={logoImg} alt="Logo Nova Solar Durango" class="h-10 md:h-12 w-auto object-contain" />
                </a>

                <div class="hidden md:flex gap-8 text-xs font-semibold uppercase tracking-widest text-gray-400">
                    <a href="/" class="hover:text-orange-500 transition">Inicio</a>
                    <a href="/galeria" class="hover:text-orange-500 transition">Proyectos</a>
                    <a href="/cotizador" class="hover:text-orange-500 transition">Cotizador</a>
                    <a href="/contacto" class="text-orange-500 transition">Contacto</a>
                    <a href="/citas" class="hover:text-orange-500 transition">Citas</a>
                </div>

                <div class="flex items-center gap-4">
                    <a
                        href={ctaBase}
                        target="_blank"
                        class="bg-green-500 text-black px-6 py-2.5 rounded-full text-xs font-black uppercase tracking-widest hover:bg-green-600 transition shadow-lg inline-block"
                    >
                        WhatsApp
                    </a>
                
                    <button id="menu-btn" class="md:hidden text-gray-300 hover:text-white focus:outline-none">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                    </button>
                </div>
            </div>
        
            <div id="mobile-menu" class="hidden md:hidden bg-black border-t border-gray-900">
                <div class="px-6 py-4 space-y-2 text-center">
                    <a href="/" class="block text-gray-400 hover:text-white py-3 border-b border-gray-900 text-sm font-bold tracking-widest uppercase">Inicio</a>
                    <a href="/galeria" class="block text-gray-400 hover:text-white py-3 border-b border-gray-900 text-sm font-bold tracking-widest uppercase">Proyectos</a>
                    <a href="/cotizador" class="block text-gray-400 hover:text-white py-3 border-b border-gray-900 text-sm font-bold tracking-widest uppercase">Cotizador</a>
                    <a href="/contacto" class="block text-orange-500 py-3 border-b border-gray-900 text-sm font-bold tracking-widest uppercase">Contacto</a>
                    <a href="/citas" class="block text-gray-400 hover:text-white py-3 text-sm font-bold tracking-widest uppercase">Citas</a>
                </div>
            </div>
        </nav>

        <main class="flex-grow pt-36 pb-20">
            <section class="container mx-auto px-6 mb-16 text-center">
                <span class="text-orange-600 font-bold tracking-widest text-xs uppercase mb-4 block">Estamos para servirte</span>
                <h1 class="text-5xl md:text-6xl font-black text-gray-950 tracking-tighter mb-4">
                    Ponte en Contacto
                </h1>
                <p class="text-xl text-gray-600 font-light max-w-2xl mx-auto">
                    ¿Tienes dudas o quieres una cotización? Envíanos un mensaje y te responderemos de inmediato.
                </p>
            </section>

            <section class="container mx-auto px-6 max-w-5xl">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
                    
                    <div class="space-y-10">
                        <h3 class="text-3xl font-extrabold text-gray-950 tracking-tight border-b border-gray-200 pb-4">
                            Nuestros Datos
                        </h3>
                        
                        <div class="flex items-start space-x-5 group">
                            <div class="flex-shrink-0">
                                <div class="flex items-center justify-center h-14 w-14 rounded-2xl bg-orange-100 text-orange-600 transition group-hover:scale-110">
                                    <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    </svg>
                                </div>
                            </div>
                            <div class="pt-1">
                                <h4 class="text-xl font-extrabold text-gray-950 tracking-tight">Oficina Central</h4>
                                <p class="mt-1 text-gray-600 font-light text-lg">C. México 205, Guadalupe, Durango.</p>
                            </div>
                        </div>

                        <div class="flex items-start space-x-5 group">
                            <div class="flex-shrink-0">
                                <div class="flex items-center justify-center h-14 w-14 rounded-2xl bg-orange-100 text-orange-600 transition group-hover:scale-110">
                                    <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                                    </svg>
                                </div>
                            </div>
                            <div class="pt-1">
                                <h4 class="text-xl font-extrabold text-gray-950 tracking-tight">Teléfono</h4>
                                <p class="mt-1 text-gray-600 font-light text-lg">
                                    <a href="tel:+526181699033" class="hover:text-orange-600 transition">(618) 169-9033</a>
                                </p>
                            </div>
                        </div>

                        <div class="flex items-start space-x-5 group">
                            <div class="flex-shrink-0">
                                <div class="flex items-center justify-center h-14 w-14 rounded-2xl bg-orange-100 text-orange-600 transition group-hover:scale-110">
                                    <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                                    </svg>
                                </div>
                            </div>
                            <div class="pt-1">
                                <h4 class="text-xl font-extrabold text-gray-950 tracking-tight">Email</h4>
                                <p class="mt-1 text-gray-600 font-light text-lg">nsolardgo@gmail.com</p>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white rounded-[30px] shadow-xl p-10 md:p-12 border border-gray-100 relative overflow-hidden">
                        <div class="absolute top-0 right-0 w-32 h-32 bg-orange-500 opacity-5 rounded-bl-[100px] pointer-events-none"></div>

                        <div id="form-container">
                            <h3 class="text-3xl font-extrabold text-gray-950 tracking-tight mb-8">Envíanos un mensaje</h3>

                            <form id="contacto-form" class="space-y-6 relative z-10">
                                <input type="hidden" name="_subject" value="Nuevo contacto desde Web Nova Solar" />
                                <input type="hidden" name="_captcha" value="false" />
                                <input type="hidden" name="_template" value="table" />

                                <div>
                                    <label class="block text-sm font-bold text-gray-950 mb-2">Nombre</label>
                                    <input type="text" name="Nombre" class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-2xl focus:ring-2 focus:ring-orange-500 focus:bg-white outline-none transition text-gray-900" placeholder="Tu nombre" required />
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div>
                                        <label class="block text-sm font-bold text-gray-950 mb-2">Email</label>
                                        <input type="email" name="Email" class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-2xl focus:ring-2 focus:ring-orange-500 focus:bg-white outline-none transition text-gray-900" placeholder="correo@ejemplo.com" required />
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-gray-950 mb-2">Teléfono</label>
                                        <input type="tel" name="Telefono" class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-2xl focus:ring-2 focus:ring-orange-500 focus:bg-white outline-none transition text-gray-900" placeholder="(618) 000-0000" />
                                    </div>
                                </div>

                                <div>
                                    <label class="block text-sm font-bold text-gray-950 mb-2">Mensaje</label>
                                    <textarea name="Mensaje" rows="4" class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-2xl focus:ring-2 focus:ring-orange-500 focus:bg-white outline-none transition text-gray-900" placeholder="Escribe tu mensaje..." required></textarea>
                                </div>

                                <button type="submit" id="btn-submit" class="w-full bg-orange-600 hover:bg-orange-700 text-white font-extrabold text-lg py-4 px-6 rounded-2xl transition duration-300 shadow-xl mt-4">
                                    Enviar Mensaje
                                </button>
                                
                                <p id="loading-text" class="text-center text-orange-600 font-bold hidden animate-pulse mt-4">Enviando mensaje...</p>
                            </form>
                        </div>

                        <div id="resultado-container" class="hidden relative z-10 text-center space-y-6 py-10 animate-fade-in-up">
                            <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto text-green-500 mb-4">
                                <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                            </div>
                            
                            <h2 class="text-3xl font-extrabold text-gray-950 tracking-tight">¡Mensaje Enviado!</h2>
                            <p class="text-gray-600 text-lg font-light">Gracias por contactarnos. Nuestro equipo revisará tu mensaje y te responderemos lo más pronto posible.</p>
                            
                            <button id="btn-nuevo" class="mt-6 text-orange-600 font-bold hover:underline transition">
                                Enviar otro mensaje
                            </button>
                        </div>

                    </div>
                </div>
            </section>
        </main>

        <footer class="bg-black text-white py-12 text-center text-sm border-t border-gray-900 mt-10">
            <div class="container mx-auto px-6 max-w-5xl">
                <img src={logoImg} alt="Logo Nova Solar" class="h-8 mx-auto mb-6 object-contain opacity-80" />
                <p class="text-gray-500">© 2026 Nova Solar Durango. Todos los derechos reservados.</p>
            </div>
        </footer>

        <script define:vars={{ correoDestino }}>
            // 1. Menú Móvil
            const btn = document.getElementById("menu-btn");
            const menu = document.getElementById("mobile-menu");
            if (btn && menu) {
                btn.addEventListener("click", () => menu.classList.toggle("hidden"));
            }

            // 2. Lógica del Formulario con FormSubmit (AJAX)
            const form = document.getElementById('contacto-form');
            const formContainer = document.getElementById('form-container');
            const resultContainer = document.getElementById('resultado-container');
            const btnSubmit = document.getElementById('btn-submit');
            const loadingText = document.getElementById('loading-text');
            const btnNuevo = document.getElementById('btn-nuevo');

            if(form) {
                form.addEventListener('submit', function(e) {
                    e.preventDefault(); // Evitar que la página recargue

                    // Cambiar estado visual a cargando
                    btnSubmit.classList.add('hidden');
                    loadingText.classList.remove('hidden');

                    const formData = new FormData(form);

                    // Petición a FormSubmit
                    fetch(`https://formsubmit.co/ajax/${correoDestino}`, {
                        method: "POST",
                        body: formData,
                        headers: {
                            'Accept': 'application/json'
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if(data.success) {
                            // Mostrar mensaje de éxito
                            formContainer.classList.add('hidden');
                            resultContainer.classList.remove('hidden');
                            form.reset(); // Limpiar el formulario
                        } else {
                            alert("Hubo un problema enviando el mensaje. Por favor intenta de nuevo.");
                            btnSubmit.classList.remove('hidden');
                            loadingText.classList.add('hidden');
                        }
                    })
                    .catch(error => {
                        console.log(error);
                        alert("Error de conexión. Por favor revisa tu internet.");
                        btnSubmit.classList.remove('hidden');
                        loadingText.classList.add('hidden');
                    });
                });

                // Botón para resetear y enviar uno nuevo
                btnNuevo.addEventListener('click', () => {
                    resultContainer.classList.add('hidden');
                    formContainer.classList.remove('hidden');
                    btnSubmit.classList.remove('hidden');
                    loadingText.classList.add('hidden');
                });
            }
        </script>
</Layout>