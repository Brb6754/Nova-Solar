<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Contacto | Nova Solar</title>
    </head>
    <body class="bg-gray-50 antialiased flex flex-col min-h-screen">
        <nav class="fixed w-full z-50 bg-black/90 backdrop-blur-sm">
            <div
                class="container mx-auto px-4 py-3 flex justify-between items-center"
            >
                <a href="/" class="flex items-center">
                    <img
                        src="/logo.svg"
                        alt="Logo Nova Solar"
                        class="h-12 md:h-16 w-auto object-contain"
                    />
                </a>
                <div
                    class="hidden md:flex gap-6 text-sm font-medium text-gray-400"
                >
                    <a href="/" class="hover:text-orange-500 transition"
                        >Inicio</a
                    >
                    <a href="/galeria" class="hover:text-orange-500 transition"
                        >Proyectos</a
                    >
                    <a
                        href="/#cotizador"
                        class="hover:text-orange-500 transition">Cotizador</a
                    >
                    <a href="/contacto" class="text-orange-500 font-bold"
                        >Contacto</a
                    >
                    <a href="/citas" class="hover:text-orange-600 transition"
                        >Citas</a
                    >
                </div>
                <div class="flex items-center gap-4">
                    <button
                        id="menu-btn"
                        class="md:hidden text-gray-300 hover:text-white focus:outline-none"
                    >
                        <svg
                            class="h-6 w-6"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M4 6h16M4 12h16M4 18h16"></path></svg
                        >
                    </button>
                </div>
            </div>
            <div
                id="mobile-menu"
                class="hidden md:hidden bg-black border-t border-gray-800"
            >
                <div class="px-4 py-3 space-y-2">
                    <a
                        href="/"
                        class="block text-gray-300 hover:text-white py-2"
                        >Inicio</a
                    >
                    <a
                        href="/galeria"
                        class="block text-gray-300 hover:text-white py-2"
                        >Proyectos</a
                    >
                    <a
                        href="/#cotizador"
                        class="block text-gray-300 hover:text-white py-2"
                        >Cotizador</a
                    >
                    <a
                        href="/contacto"
                        class="block text-orange-500 font-bold py-2">Contacto</a
                    >
                    <a
                        href="/citas"
                        class="block text-gray-300 hover:text-white py-2"
                        >Citas</a
                    >
                </div>
            </div>
        </nav>

        <main class="flex-grow pt-32 pb-20">
            <section class="container mx-auto px-4 mb-12 text-center">
                <span
                    class="text-orange-500 font-bold tracking-widest text-xs uppercase mb-2 block"
                    >Estamos para servirte</span
                >
                <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
                    Ponte en Contacto
                </h1>
                <p class="text-xl text-gray-600 max-w-2xl mx-auto">
                    ¿Tienes dudas o quieres una cotización? Envíanos un mensaje.
                </p>
            </section>

            <section class="container mx-auto px-4">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
                    <div class="space-y-8">
                        <h3
                            class="text-2xl font-bold text-gray-900 border-b border-gray-200 pb-4"
                        >
                            Nuestros Datos
                        </h3>
                        <div class="flex items-start space-x-4 group">
                            <div class="flex-shrink-0">
                                <div
                                    class="flex items-center justify-center h-12 w-12 rounded-lg bg-orange-100 text-orange-600"
                                >
                                    <svg
                                        class="h-6 w-6"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                        ><path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                        ></path><path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                        ></path></svg>
                                </div>
                            </div>
                            <div>
                                <h4 class="text-lg font-bold text-gray-900">
                                    Oficina Central
                                </h4><p class="mt-1 text-gray-600">
                                    C. México 205, Guadalupe, Durango.
                                </p>
                            </div>
                        </div>
                        <div class="flex items-start space-x-4 group">
                            <div class="flex-shrink-0">
                                <div
                                    class="flex items-center justify-center h-12 w-12 rounded-lg bg-orange-100 text-orange-600"
                                >
                                    <svg
                                        class="h-6 w-6"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                        ><path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                        ></path></svg>
                                </div>
                            </div>
                            <div>
                                <h4 class="text-lg font-bold text-gray-900">
                                    Teléfono
                                </h4><p class="mt-1 text-gray-600">
                                    <a href="tel:+526181699033"
                                        >(618) 169-9033</a>
                                </p>
                            </div>
                        </div>
                        <div class="flex items-start space-x-4 group">
                            <div class="flex-shrink-0">
                                <div
                                    class="flex items-center justify-center h-12 w-12 rounded-lg bg-orange-100 text-orange-600"
                                >
                                    <svg
                                        class="h-6 w-6"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                        ><path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                        ></path></svg>
                                </div>
                            </div>
                            <div>
                                <h4 class="text-lg font-bold text-gray-900">
                                    Email
                                </h4><p class="mt-1 text-gray-600">
                                    nsolardgo@gmail.com
                                </p>
                            </div>
                        </div>
                    </div>

                    <div
                        class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100 relative overflow-hidden"
                    >
                        <div
                            class="absolute top-0 right-0 w-20 h-20 bg-orange-500 opacity-10 rounded-bl-full pointer-events-none"
                        >
                        </div>

                        <h3 class="text-2xl font-bold text-gray-900 mb-6">
                            Envíanos un mensaje
                        </h3>

                        <form
                            action="https://formspree.io/f/xkoowrjo"
                            method="POST"
                            enctype="multipart/form-data"
                            class="space-y-5"
                        >
                            <input
                                type="hidden"
                                name="_next"
                                value="/gracias"
                            />

                            <input
                                type="hidden"
                                name="_subject"
                                value="Nuevo contacto desde Web Nova Solar"
                            />

                            <div>
                                <label
                                    class="block text-sm font-medium text-gray-700 mb-1"
                                    >Nombre</label
                                >
                                <input
                                    type="text"
                                    name="nombre"
                                    class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none"
                                    placeholder="Tu nombre"
                                    required
                                />
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                <div>
                                    <label
                                        class="block text-sm font-medium text-gray-700 mb-1"
                                        >Email</label
                                    >
                                    <input
                                        type="email"
                                        name="email"
                                        class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none"
                                        placeholder="correo@ejemplo.com"
                                        required
                                    />
                                </div>
                                <div>
                                    <label
                                        class="block text-sm font-medium text-gray-700 mb-1"
                                        >Teléfono</label
                                    >
                                    <input
                                        type="tel"
                                        name="telefono"
                                        class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none"
                                        placeholder="(618) 000-0000"
                                    />
                                </div>
                            </div>

                            <div>
                                <label
                                    class="block text-sm font-medium text-gray-700 mb-1"
                                    >Foto Recibo CFE (Opcional)</label
                                >
                                <div
                                    class="relative border-2 border-dashed border-gray-300 bg-gray-50 rounded-lg p-6 hover:bg-gray-100 transition text-center group cursor-pointer"
                                >
                                    <input
                                        type="file"
                                        name="upload"
                                        id="file-input"
                                        accept="image/*,.pdf"
                                        class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
                                    />

                                    <div
                                        class="space-y-1"
                                        id="file-label-container"
                                    >
                                        <svg
                                            class="mx-auto h-10 w-10 text-gray-400 group-hover:text-orange-500 transition"
                                            stroke="currentColor"
                                            fill="none"
                                            viewBox="0 0 48 48"
                                        >
                                            <path
                                                d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"></path>
                                        </svg>
                                        <div class="text-sm text-gray-600">
                                            <span
                                                class="font-medium text-orange-600"
                                                id="file-text"
                                                >Sube una foto</span
                                            >
                                        </div>
                                        <p
                                            class="text-xs text-gray-500"
                                            id="file-subtext"
                                        >
                                            PNG, JPG o PDF hasta 5MB
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div>
                                <label
                                    class="block text-sm font-medium text-gray-700 mb-1"
                                    >Mensaje</label
                                >
                                <textarea
                                    name="mensaje"
                                    rows="4"
                                    class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none"
                                    placeholder="Escribe tu mensaje..."
                                ></textarea>
                            </div>

                            <button
                                type="submit"
                                class="w-full bg-orange-600 hover:bg-orange-700 text-white font-bold py-3 px-4 rounded-lg transition duration-300 shadow-md"
                            >
                                Enviar Mensaje
                            </button>
                        </form>
                    </div>
                </div>
            </section>
        </main>

        <footer
            class="bg-black text-white py-8 text-center text-sm border-t border-slate-800"
        >
            <p>© 2026 Nova Solar. Todos los derechos reservados.</p>
        </footer>

        <script>
            // Menú Móvil
            const btn = document.getElementById("menu-btn");
            const menu = document.getElementById("mobile-menu");
            if (btn && menu) {
                btn.addEventListener("click", () =>
                    menu.classList.toggle("hidden"),
                );
            }

            // Script visual para mostrar nombre del archivo seleccionado
            const fileInput = document.getElementById("file-input");
            const fileText = document.getElementById("file-text");
            const fileSubtext = document.getElementById("file-subtext");

            if (fileInput) {
                fileInput.addEventListener("change", function (e) {
                    if (this.files && this.files.length > 0) {
                        const fileName = this.files[0].name;
                        // Cambiar texto al nombre del archivo
                        fileText.textContent = "Archivo seleccionado:";
                        fileSubtext.textContent = fileName;
                        fileSubtext.classList.add(
                            "text-orange-600",
                            "font-bold",
                        );
                    }
                });
            }
        </script>
    </body>
</html>
